+                     'scenarios': len(RESULTS), 'failed': failed,
+                     'receipt': str(RUN / 'TEST-RECEIPT.json'),
+                     'receipt_sha256': sha((RUN / 'TEST-RECEIPT.json').read_bytes())}))
+    return 0 if result['result'] == 'PASS' else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
